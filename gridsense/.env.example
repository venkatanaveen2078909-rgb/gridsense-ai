# GRIDSENSE — Environment Configuration
# Copy this file to .env and fill in your actual values.
# Load automatically with: pip install python-dotenv

# ── AI Backend (set at least one) ────────────────────────────────────────────
# Groq is free and recommended for development.
GROQ_API_KEY=your_groq_api_key_here
GRIDSENSE_GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (fallback or alternative)
# ANTHROPIC_API_KEY=sk-ant-...
# GRIDSENSE_MODEL=claude-haiku-4-5

# ── Dashboard API Security ────────────────────────────────────────────────────
# Set this to a random secret. The dashboard will require this in the
# X-API-Key header. Leave blank to run without auth (development only).
GRIDSENSE_API_KEY=change_me_to_a_random_secret

# ── Financial Parameters ──────────────────────────────────────────────────────
GRIDSENSE_TARIFF=5.2
GRIDSENSE_CURRENCY=INR

# ── Detection Thresholds ──────────────────────────────────────────────────────
GRIDSENSE_PR_ALERT=0.80
GRIDSENSE_PEER_RATIO=0.85

# ── Daemon Tuning ─────────────────────────────────────────────────────────────
GRIDSENSE_COOLDOWN_S=900
GRIDSENSE_TELEMETRY_TTL_H=48
GRIDSENSE_POLL_S=2

# ── Infrastructure (Phase 2) ──────────────────────────────────────────────────
# Using Docker Compose, these will be automatically set to the internal service names.
# For local dev without Docker, point these to your Postgres and Redis instances.
DATABASE_URL=postgresql://gridsense:gridsense_password@localhost:5432/gridsense_db
REDIS_URL=redis://localhost:6379/0

# ── Enterprise SaaS (Phase 3) ─────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_signing_key_for_gridsense

# ── Logging ───────────────────────────────────────────────────────────────────
GRIDSENSE_LOG_LEVEL=INFO
